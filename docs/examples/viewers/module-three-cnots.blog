BLOG 1.0

module CNOT {
  in control_in: data = 0
  out control_out: data = 3
  in target_in: data = 6
  out target_out: data = 9

  0: Port [0, 0, 0] <In_Control>
  1: ZXZ [0, 0, 1]
  2: ZXZ [0, 0, 2]
  3: Port [0, 0, 3] <Out_Control>
  4: ZXX [0, 1, 1]
  5: ZXZ [0, 1, 2]
  6: Port [1, 1, 0] <In_Target>
  7: ZXZ [1, 1, 1]
  8: ZXZ [1, 1, 2]
  9: Port [1, 1, 3] <Out_Target>
  0 -> +Z
  1 -> +Z
  1 -> +Y
  2 -> +Z
  4 -> +Z
  5 -> +X
  6 -> +Z
  7 -> +Z
  8 -> +Z

}

module main {
  in child0_control_in: data = 0
  in child0_target_in: data = 1
  out child2_control_out: data = 3
  out child2_target_out: data = 2

  child0: CNOT @ [0, 0, 0]
  child1: CNOT @ [0, 0, 2]
  child2: CNOT @ [0, 0, 4]

  0: Port [0, 0, 0] role=input <child0_control_in>
  1: Port [1, 1, 0] role=input <child0_target_in>
  2: Port [1, 1, 7] role=output <child2_target_out>
  3: Port [0, 0, 7] role=output <child2_control_out>

  0 -> child0.control_in
  1 -> child0.target_in
  child2.control_out -> 3
  child2.target_out -> 2
  child0.control_out -> child1.control_in
  child0.target_out -> child1.target_in
  child1.control_out -> child2.control_in
  child1.target_out -> child2.target_in
}
