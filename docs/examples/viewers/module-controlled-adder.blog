  33: XZZ [2, 1, 1]
  34: XZZ [2, 1, 0]
  35: XZ [2, 1, 2] <fix1_0>
  36: ZXZ [4, 1, 0]
  37: Port [5, 1, 0] role=multiplex <i_k>
  0 -> +X
  0 -> -X
  1 -> +X
  1 -> +Y
  2 -> +X
  3 -> +X
  4 -> +Z
  5 -> +Y
  6 -> +Y
  7 -> -Z
  8 -> +X
