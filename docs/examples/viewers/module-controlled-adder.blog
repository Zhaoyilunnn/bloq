  20 -> +X
  21 -H> +Z
  22 -> +Y
  22 -> +Z
  22 -> -Y
  23 -> +X
  24 -> +X
  25 -> +X
  25 -> -Y
  26 -> +Z
  28 -> +X
  29 -> +Y
  29 -> +X
  30 -> +Z
  33 -> -Z
  33 -> +Z
  36 -> +X

  m1 = measure 0
  m2 = measure 16
  resolve 32 if m1
  resolve 35 if !m1
  resolve 13 if !m2
  resolve 31 if m2
  feedback X 27 if m1 & m2

}

