module main {
  in child0_ccz_2: ccz = 0
  in child0_ccz_0: ccz = 1
  in child0_ccz_1: ccz = 2
  in child0_q: data = 3
  in child0_i_k: data = 4
  in child1_ccz_1: ccz = 10
  in child1_ccz_3: ccz = 9
  in child1_ccz_2: ccz = 6
  in child1_c_k: data = 7
  in child1_t_k: data = 11
  out child1_c_k_plus_1: data = 8
  out child2_out_k: data = 12

  child0: AND @ [0, 0, 0]
  child1: MAJ @ [0, 0, 3]
  child2: UMA @ [3, 0, 8]

  0: Port [-1, 0, 0] role=input <child0_ccz_2>
  1: Port [-1, 2, 0] role=input <child0_ccz_0>
  2: Port [-1, 1, 0] role=input <child0_ccz_1>
  3: Port [5, 2, 0] role=multiplex <child0_q>
  4: Port [5, 1, 0] role=multiplex <child0_i_k>
  5: XZZ [0, 1, 2]
  6: Port [-1, 2, 5] role=input <child1_ccz_2>
  7: Port [2, -1, 3] role=input <child1_c_k>
  8: Port [2, 3, 3] role=output <child1_c_k_plus_1>
  9: Port [-1, 1, 5] role=input <child1_ccz_3>
  10: Port [-1, 0, 5] role=input <child1_ccz_1>
  11: Port [5, 1, 6] role=input <child1_t_k>
  12: Port [5, 0, 9] role=output <child2_out_k>

  0 -> child0.ccz_2
  1 -> child0.ccz_0
  2 -> child0.ccz_1
  3 -> child0.q
  4 -> child0.i_k
  10 -> child1.ccz_1
  9 -> child1.ccz_3
  6 -> child1.ccz_2
  7 -> child1.c_k
  11 -> child1.t_k
  child1.c_k_plus_1 -> 8
  child2.out_k -> 12
  child0.qi_k -> 5
  5 -> child1.i_prime_k
  child1.c_k_out -H> child2.c_k
  child1.c_k_plus_1_duplicate -> child2.c_k_plus_1
  child1.c_k_xor_i_prime_k -> child2.c_k_xor_i_prime_k
  child1.c_k_xor_t_k -H> child2.c_k_xor_t_k
}
