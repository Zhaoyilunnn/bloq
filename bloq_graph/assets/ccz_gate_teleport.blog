BLOG 1.0

module main {
in x: data = 6
in y: data = 10
in z: data = 15
in ccz_0: ccz = 3
in ccz_1: ccz = 4
in ccz_2: ccz = 5

3: Port [0, 2, 0] role=input <CCZ_0>
4: Port [1, 2, 0] role=input <CCZ_1>
5: Port [2, 2, 0] role=input <CCZ_2>
6: Port [0, 0, 1] role=multiplex <x>
7: ZXX [0, 1, 1]
9: ZXX [0, 2, 1]
10: Port [1, 0, 1] role=multiplex <y>
11: ZZX [1, 1, 1]
12: ZXX [1, 2, 1]
15: Port [2, 0, 1] role=multiplex <z>
16: ZZX [2, 1, 1]
18: ZXX [2, 2, 1]
19: ZZX [1, 3, 1]
20: XZX [0, 3, 1]
22: ZXX [2, 3, 1]
[0, 2, 0] -> +Z
[1, 2, 0] -> +Z
[0, 0, 1] -> +Y
[0, 1, 1] -> +Y
[1, 0, 1] -> +Y
[1, 1, 1] -> +Y
[1, 2, 1] -> +Y
[2, 0, 1] -> +Y
[2, 1, 1] -> +Y
[2, 2, 1] -> -Z
[2, 2, 1] -> +Y
[1, 3, 1] -> -X
[2, 3, 1] -> +Z
[1, 2, 1] -> +Z
[0, 1, 1] -> +Z
[2, 2, 1] -> +Z
[0, 3, 1] -> +Z
[0, 2, 1] -> +Z
branch b0 {
  false {
    30: X [2, 3, 2]
    31: X [1, 2, 2]
  }
  true {
    23: ZXZ [2, 3, 2]
    25: ZXX [1, 2, 2]
    27: ZZX [1, 3, 2]
    [2, 3, 2] -H> -X
    [1, 3, 2] -> -Y
  }
}
branch b1 {
  false {
    32: X [0, 1, 2]
    33: X [2, 2, 2]
  }
  true {
    8: ZXZ [0, 1, 2]
    26: ZXX [2, 2, 2]
    28: ZZX [2, 1, 2]
    29: ZZX [1, 1, 2]
    [2, 2, 2] -> -Y
    [2, 1, 2] -> -X
    [1, 1, 2] -H> -X
  }
}
branch b2 {
  false {
    34: X [0, 3, 2]
    35: X [0, 2, 2]
  }
  true {
    21: XZZ [0, 3, 2]
    24: ZXX [0, 2, 2]
    [0, 2, 2] -H> +Y
  }
}

m0x = measure 6 -> +Y
m1y = measure 10 -> +Y
m2z = measure 15 -> +Y
resolve b0 if m0x
resolve b1 if m1y
resolve b2 if m2z
feedback Z 15 if m0x & m1y
feedback Z 10 if m0x & m2z
feedback Z 6 if m1y & m2z
}
